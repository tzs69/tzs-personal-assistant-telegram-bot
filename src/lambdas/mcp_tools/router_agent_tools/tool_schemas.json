[
  {
    "name": "send_telegram_message",
    "description": "Send a text message to a Telegram chat.",
    "input_schema": {
      "type": "object",
      "description": "Telegram message delivery details.",
      "properties": [
        {
          "name": "text",
          "type": "string",
          "description": "Text content to send.",
          "required": true
        },
        {
          "name": "sender_id",
          "type": "integer",
          "description": "Telegram chat identifier that receives the message.",
          "required": true
        }
      ]
    },
    "output_schema": {
      "type": "object",
      "description": "Telegram message delivery result.",
      "properties": [
        {
          "name": "ok",
          "type": "boolean",
          "description": "Whether Telegram accepted the message.",
          "required": true
        },
        {
          "name": "date",
          "type": "string",
          "description": "UTC delivery timestamp when the message succeeds.",
          "required": false
        },
        {
          "name": "error",
          "type": "string",
          "description": "Telegram error details when delivery fails.",
          "required": false
        }
      ]
    }
  }
]
